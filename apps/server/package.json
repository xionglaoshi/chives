{
  "name": "@chives/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/api/protocol.d.ts",
      "default": "./dist/api/protocol.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/semver": "^7.8.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@chives/acp-client": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "semver": "7.8.6",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
