diff --git a/packages/mcp/mcp-client/tests/tool-filter.spec.ts b/packages/mcp/mcp-client/tests/tool-filter.spec.ts
new file mode 100644
index 0000000000..9a0fb99e0c
--- /dev/null
+++ b/packages/mcp/mcp-client/tests/tool-filter.spec.ts
@@ -0,0 +1,191 @@
+/**
+ * Tests for the mcp-client tool filter: `allowTools` and `denyTools` select
+ * tools by their upstream raw name before registration, and every re-sync
+ * (including the one after a reconnect) applies the same selection.
+ * Isolated file so vi.mock of the MCP SDK doesn't pollute other test suites.
+ */
+import * as NativeToolExecutor from '@deepseek-ai/dsh-tool-executor-native'
+import { describe, expect, it, vi, beforeEach, afterEach } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+import type { Config, StdioConfig } from '@deepseek-ai/dsh-mcp-client'
+
+// ---- Mock MCP SDK ----
+
+// vi.mock factories are hoisted above every import/const, so the mock fns and
+// class must be created inside vi.hoisted to exist when the factories run.
+const { mockConnect, mockClose, mockListTools, mockCallTool, mockSetNotificationHandler, MockClient, instances } = vi.hoisted(() => {
+  const mockConnect = vi.fn<() => Promise<void>>()
+  const mockClose = vi.fn<() => Promise<void>>()
+  const mockListTools = vi.fn<(_params?: Record<string, unknown>) => Promise<unknown>>()
+  const mockCallTool = vi.fn<(
+    _params?: Record<string, unknown>, _options?: unknown,
+  ) => Promise<unknown>>()
+  const mockSetNotificationHandler = vi.fn()
+  class MockClient {
+    transport: object | undefined = {}
+    onclose: (() => void) | undefined
+    connect = mockConnect
+    close = mockClose
+    getServerCapabilities = () => ({ tools: {} })
+    getInstructions(): string | undefined { return undefined }
+    listTools = mockListTools
+    callTool = mockCallTool
+    constructor(_info: unknown, options: { listChanged: { tools: { onChanged: () => void } } }) {
+      instances.push(this)
+      mockSetNotificationHandler('notifications/tools/list_changed', options.listChanged.tools.onChanged)
+    }
+  }
+  const instances: MockClient[] = []
+  return { mockConnect, mockClose, mockListTools, mockCallTool, mockSetNotificationHandler, MockClient, instances }
+})
+
+vi.mock('@modelcontextprotocol/client', () => ({
+  Client: MockClient,
+  StreamableHTTPClientTransport: vi.fn(),
+}))
+
+vi.mock('@modelcontextprotocol/client/stdio', () => ({
+  StdioClientTransport: vi.fn(),
+}))
+
+// vi.mock is hoisted above static imports, so the module under test sees the
+// mocked SDK even through a static import.
+import { apply } from '@deepseek-ai/dsh-mcp-client/src/index.ts'
+
+// ---- Helpers ----
+
+async function mountRegistry(): Promise<Context> {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(NativeToolExecutor)
+  return ctx
+}
+
+function stdioConfig(overrides: Partial<StdioConfig> = {}): Config {
+  return {
+    transport: 'stdio',
+    serverName: 'srv',
+    command: 'echo',
+    args: [],
+    env: {},
+    cwd: '',
+    toolCallTimeoutMs: 60_000,
+    failOnStartupError: false,
+    ...overrides,
+  }
+}
+
+/** The tool list the mock server advertises. */
+function listing(...names: string[]): { tools: { name: string; inputSchema: { type: string } }[]; nextCursor: undefined } {
+  return {
+    tools: names.map(name => ({ name, inputSchema: { type: 'object' } })),
+    nextCursor: undefined,
+  }
+}
+
+/** Capture the bridge's logger lines by level on one context. */
+function captureLogs(ctx: Context): { warns: string[] } {
+  const warns: string[] = []
+  ctx.logger.warn = ((message: unknown) => { warns.push(String(message)) }) as typeof ctx.logger.warn
+  return { warns }
+}
+
+// ---- Tests ----
+
+describe('mcp-client tool filter', () => {
+  let ctx: Context
+
+  beforeEach(async () => {
+    vi.clearAllMocks()
+    instances.length = 0
+    mockConnect.mockResolvedValue(undefined)
+    mockClose.mockImplementation(function (this: { onclose?: () => void }) {
+      this.onclose?.()
+      return Promise.resolve()
+    })
+    mockListTools.mockResolvedValue(listing('alpha', 'beta'))
+    mockCallTool.mockResolvedValue({ content: [{ type: 'text', text: 'ok' }] })
+    ctx = await mountRegistry()
+  })
+
+  afterEach(async () => {
+    await ctx.fiber.dispose()
+  })
+
+  it('registers every discovered tool when neither list is configured', async () => {
+    await apply(ctx, stdioConfig())
+
+    expect(ctx.tools.get('mcp__srv__alpha')).toBeDefined()
+    expect(ctx.tools.get('mcp__srv__beta')).toBeDefined()
+  })
+
+  it('registers only the tools named in allowTools', async () => {
+    await apply(ctx, stdioConfig({ allowTools: ['beta'] }))
+
+    expect(ctx.tools.get('mcp__srv__alpha')).toBeUndefined()
+    expect(ctx.tools.get('mcp__srv__beta')).toBeDefined()
+  })
+
+  it('does not register the tools named in denyTools', async () => {
+    await apply(ctx, stdioConfig({ denyTools: ['alpha'] }))
+
+    expect(ctx.tools.get('mcp__srv__alpha')).toBeUndefined()
+    expect(ctx.tools.get('mcp__srv__beta')).toBeDefined()
+  })
+
+  it('applies allowTools first and then removes the denyTools names', async () => {
+    await apply(ctx, stdioConfig({ allowTools: ['alpha', 'beta'], denyTools: ['beta'] }))
+
+    expect(ctx.tools.get('mcp__srv__alpha')).toBeDefined()
+    expect(ctx.tools.get('mcp__srv__beta')).toBeUndefined()
+  })
+
+  it('matches names exactly, without wildcards', async () => {
+    await apply(ctx, stdioConfig({ allowTools: ['alp*'] }))
+
+    expect(ctx.tools.get('mcp__srv__alpha')).toBeUndefined()
+    expect(ctx.tools.get('mcp__srv__beta')).toBeUndefined()
+  })
+
+  it('warns about an allowTools name the server does not list and keeps activation successful', async () => {
+    const { warns } = captureLogs(ctx)
+    await apply(ctx, stdioConfig({ allowTools: ['alpha', 'missing'], failOnStartupError: true }))
+
+    expect(ctx.tools.get('mcp__srv__alpha')).toBeDefined()
+    expect(warns.some(line => line.includes('allowTools entry "missing" matches no tool listed'))).toBe(true)
+  })
+
+  it('applies the filter when a ToolListChanged notification re-syncs the list', async () => {
+    mockListTools.mockResolvedValue(listing('alpha'))
+    await apply(ctx, stdioConfig({ allowTools: ['alpha', 'gamma'] }))
+    expect(ctx.tools.get('mcp__srv__alpha')).toBeDefined()
+
+    mockListTools.mockResolvedValue(listing('alpha', 'beta', 'gamma'))
+    const handler = mockSetNotificationHandler.mock.calls[0]![1] as () => void
+    handler()
+
+    await vi.waitFor(() => { expect(ctx.tools.get('mcp__srv__gamma')).toBeDefined() })
+    expect(ctx.tools.get('mcp__srv__alpha')).toBeDefined()
+    expect(ctx.tools.get('mcp__srv__beta')).toBeUndefined()
+  })
+
+  it('applies the filter when a reconnect re-syncs the list', async () => {
+    await apply(ctx, stdioConfig({
+      allowTools: ['alpha', 'gamma'],
+      reconnect: { initialDelayMs: 5, maxDelayMs: 40, maxAttempts: 3 },
+    }))
+    expect(ctx.tools.get('mcp__srv__alpha')).toBeDefined()
+    expect(ctx.tools.get('mcp__srv__beta')).toBeUndefined()
+
+    mockListTools.mockResolvedValue(listing('alpha', 'beta', 'gamma'))
+    instances[0]!.onclose?.()
+
+    await vi.waitFor(() => { expect(instances).toHaveLength(2) })
+    await vi.waitFor(() => { expect(ctx.tools.get('mcp__srv__gamma')).toBeDefined() })
+    expect(ctx.tools.get('mcp__srv__alpha')).toBeDefined()
+    expect(ctx.tools.get('mcp__srv__beta')).toBeUndefined()
+  })
+})
